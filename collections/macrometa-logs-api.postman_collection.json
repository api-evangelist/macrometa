          "name": "Retrieve the function logs",
          "request": {
            "name": "Retrieve the function logs",
            "description": {
              "content": "Retrieve the function logs in the specified period. If no period is specified it will return the last hour logs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "faas",
                "v1",
                "logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "The start of the period requested. Example: \"2024-01-01T00:00:00\"."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "The end of the period requested. Example: \"2024-01-02T00:00:00\"."
                },
                {
                  "disabled": false,
                  "key": "lines",
                  "value": "<string>",
                  "description": "The number of logs. Example: \"100\"."
                },
                {
                  "disabled": false,
                  "key": "asc",
                  "value": "<string>",
                  "description": "The sort logs by time. Example: \"true\"."
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "The region of logs. Example: \"us-west\"."
                },
                {
                  "disabled": false,
                  "key": "instance",
                  "value": "<string>",
                  "description": "The region of logs. Example: \"13638401-f561-4742-9d2e-7aeebf2243ad\"."
                },
                {
                  "disabled": false,
                  "key": "functionName",
                  "value": "<string>",
                  "description": "The function name. Example: \"periods\"."
                },
                {
                  "disabled": false,
                  "key": "functionVersion",
                  "value": "<string>",
                  "description": "The function version. Example: \"0.0.1\"."
                },
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "The level of logs. Example: \"ERROR\"."
                },
                {
                  "disabled": false,
                  "key": "executionId",
                  "value": "<string>",
                  "description": "The execution id. Example: \"664d1ecc-58158f1a\"."
                }
              ],
              "variable": []
            },
            "method": "GET"
          },
