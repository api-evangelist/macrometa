            "params": [
              {
                "name": "fabric",
                "value": "",
                "type": "path",
                "description": "Fabric name of the resource."
              },
              {
                "name": "collection-name",
                "value": "",
                "type": "path",
                "description": "Collection name."
              }
            ]
          },
          "docs": "Retrieve details of assigned workflows to a collection."
