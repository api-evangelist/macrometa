          "http": {
            "method": "PUT",
            "url": "https://api-play.paas.macrometa.io/_fabric/:fabric/_api/collection/:collection-name/metadata",
            "params": [
              {
                "name": "fabric",
                "value": "",
                "type": "path",
                "description": "Fabric name of the resource."
              },
              {
                "name": "collection-name",
                "value": "",
                "type": "path",
                "description": "Collection name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update metadata related to the collection."
        },
        {
          "info": {
            "name": "Truncate and reload data",
            "type": "http"
