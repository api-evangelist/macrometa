        {
          "info": {
            "name": "Remove workflow",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api-play.paas.macrometa.io/_fabric/:fabric/_api/collection/:collection-name/workflows/:workflow-name",
            "params": [
              {
                "name": "fabric",
                "value": "",
                "type": "path",
                "description": "Fabric name of the resource."
              },
              {
                "name": "collection-name",
                "value": "",
                "type": "path",
                "description": "Collection name."
              },
              {
                "name": "workflow-name",
                "value": "",
                "type": "path",
                "description": "Name of the workflow."
              }
            ]
          },
          "docs": "Remove a workflow from a collection."
