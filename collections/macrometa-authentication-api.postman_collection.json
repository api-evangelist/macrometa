          "name": "Obtain JWT Authentication token for user.",
          "request": {
            "name": "Obtain JWT Authentication token for user.",
            "description": {
              "content": "Obtain a JWT Authentication for a user.\n\nAfter obtaining the token, REST API calls may be invoked by passing the obtained token in the REST header. Either email or both tenant and username are required. Add the following to your header when you make REST calls: *\"Authorization: bearer TOKEN\"*",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "_open",
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"<string>\",\n  \"email\": \"<string>\",\n  \"tenant\": \"<string>\",\n  \"username\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
